---
type IconName =
  | 'building'
  | 'smartphone'
  | 'globe'
  | 'code'
  | 'person'
  | 'shield'
  | 'github'
  | 'linkedin'
  | 'x'
  | 'mail'
  | 'youtube'
  | 'instagram'
  | 'tiktok'
  | 'arrow-up-right';

interface Props {
  name: IconName;
  class?: string;
  style?: string;
}

const { name, class: className = '', style = '' } = Astro.props;
---

{name === 'building' && (
  <svg class={className} style={style} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-4h6v4"/>
  </svg>
)}

{name === 'smartphone' && (
  <svg class={className} style={style} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <rect x="5" y="2" width="14" height="20" rx="2"/>
    <line x1="12" y1="18" x2="12.01" y2="18"/>
  </svg>
)}

{name === 'globe' && (
  <svg class={className} style={style} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="10"/>
    <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>

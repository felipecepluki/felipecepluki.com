---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';

const social = [
  { label: 'GitHub',    icon: 'github'    as const, url: 'https://github.com/felipecepluki',            desc: 'code, projects and experiments',          color: '#adbac7' },
  { label: 'Instagram', icon: 'instagram' as const, url: 'https://instagram.com/felipecepluki',         desc: 'behind the scenes and daily life',        color: '#e1306c' },
  { label: 'TikTok',    icon: 'tiktok'    as const, url: 'https://tiktok.com/@felipecepluki',           desc: 'short-form tech videos',                  color: '#69c9d0' },
  { label: 'LinkedIn',  icon: 'linkedin'  as const, url: 'https://linkedin.com/in/felipecepluki',       desc: 'career and networking',                   color: '#70b5f9' },
  { label: 'X',         icon: 'x'         as const, url: 'https://x.com/felipecepluki',                 desc: 'thoughts on tech and startups',           color: '#e7e9ea' },
  { label: 'Email',     icon: 'mail'      as const, url: 'mailto:cepluki.felipe@protonmail.com',        desc: 'reach out directly',                      color: '#00c8ff' },
];

const pages = [
  { name: 'about me', desc: 'who I am, what I do',    href: '/en/about', icon: 'person' as const, color: '#8b5cf6' },
  { name: 'stack',    desc: 'tools and technologies', href: '/en/stack', icon: 'code'   as const, color: '#10b981' },
];
---

<Layout lang="en" title="Felipe Cepluki" description="Software engineer. Founder. Builder of things." hideLangSwitcher>
  <div class="max-w-5xl mx-auto py-6 sm:py-12">

    <!-- ─── hero ─────────────────────────────────────────────── -->
    <section class="mb-10 fade-up">
      <div class="flex items-center justify-between mb-4">
        <div class="relative shrink-0">
          <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-full p-[2px] bg-gradient-to-br from-[#00c8ff] to-[#8b5cf6]">
            <img src="https://github.com/felipecepluki.png" alt="Felipe Cepluki" class="w-full h-full rounded-full object-cover" />
          </div>
          <div class="absolute inset-0 rounded-full bg-gradient-to-br from-[#00c8ff]/20 to-[#8b5cf6]/20 blur-2xl scale-[1.8] -z-10" />
        </div>
        <div class="flex items-center gap-3 shrink-0">
          <a href="/" class="group flex items-center gap-1">
            <span class="text-sm font-display font-medium text-muted/60 group-hover:text-muted transition-colors">PT</span>
            <span class="text-xs text-muted/40 group-hover:text-muted/60 transition-colors hidden sm:inline">· Brasil</span>
          </a>
          <span class="text-border/50 text-xs">·</span>
          <span class="flex items-center gap-1">
            <span class="text-sm font-display font-medium text-[#00c8ff]">EN</span>
            <span class="text-xs text-muted hidden sm:inline">· USA</span>
          </span>
        </div>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-1">
        <span class="bg-gradient-to-r from-[#00c8ff] to-[#8b5cf6] bg-clip-text text-transparent">
          Felipe Cepluki
        </span>
      </h1>
      <p class="text-muted text-sm sm:text-base">software engineer · founder · builder</p>
    </section>

    <!-- ─── nunca esqueci ─────────────────────────────────────── -->
    <section class="mb-10 fade-up delay-1">
      <div class="flex items-center gap-3 mb-3">
        <div class="h-px flex-1 bg-gradient-to-r from-transparent to-border" />
        <span class="text-[10px] text-muted uppercase tracking-[0.18em]">featured</span>
        <div class="h-px flex-1 bg-gradient-to-l from-transparent to-border" />
      </div>

      <a
        href="https://nuncaesqueci.com"
        target="_blank"
        rel="noopener noreferrer"
        class="group relative block p-6 sm:p-8 rounded-2xl border border-[#00c8ff]/25 overflow-hidden hover:border-[#00c8ff]/50 hover:scale-[1.005] active:scale-[0.999] transition-all duration-300"
      >
        <div class="absolute inset-0 bg-gradient-to-br from-[#00c8ff]/8 via-transparent to-[#8b5cf6]/5" />
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[#00c8ff]/70 to-transparent" />
        <div class="absolute -top-16 -right-16 w-64 h-64 rounded-full bg-[#00c8ff]/6 blur-3xl group-hover:bg-[#00c8ff]/10 transition-colors duration-700 pointer-events-none" />
        <div class="absolute -bottom-12 -left-8 w-48 h-48 rounded-full bg-[#8b5cf6]/4 blur-3xl pointer-events-none" />

        <div class="relative z-10 flex items-start justify-between gap-4">
          <div>
            <div class="flex items-center gap-2.5 mb-4">
              <div class="w-10 h-10 rounded-xl bg-[#00c8ff]/12 border border-[#00c8ff]/30 flex items-center justify-center">
                <Icon name="smartphone" class="w-5 h-5" style="color: #00c8ff" />
              </div>
              <span class="flex items-center gap-1.5 text-xs px-2.5 py-1 rounded-full bg-[#00c8ff]/10 text-[#00c8ff] border border-[#00c8ff]/25 font-medium">
                <span class="w-1.5 h-1.5 rounded-full bg-[#00c8ff] animate-pulse shrink-0" />
                in development
              </span>
            </div>
            <h2 class="text-3xl sm:text-4xl font-bold text-foreground tracking-tight mb-2">Nunca Esqueci</h2>
            <p class="text-muted text-sm sm:text-base">mobile app · coming soon</p>
          </div>
          <Icon name="arrow-up-right" class="w-4 h-4 sm:w-5 sm:h-5 text-muted/50 group-hover:text-[#00c8ff] group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all duration-200 shrink-0 mt-1" />
        </div>
      </a>
    </section>

    <!-- ─── youtube + social ──────────────────────────────────── -->
    <section class="mb-10 fade-up delay-2">
      <div class="flex items-center gap-3 mb-3">
        <div class="h-px flex-1 bg-gradient-to-r from-transparent to-border" />
        <span class="text-[10px] text-muted uppercase tracking-[0.18em]">online</span>
        <div class="h-px flex-1 bg-gradient-to-l from-transparent to-border" />
      </div>

      <!-- youtube (full width) -->
      <a
        href="https://www.youtube.com/@felipecepluki"
        target="_blank"
        rel="noopener noreferrer"
        class="group relative flex items-center gap-4 p-5 sm:p-6 rounded-2xl border border-[#ef4444]/25 overflow-hidden hover:border-[#ef4444]/50 hover:scale-[1.005] active:scale-[0.999] transition-all duration-200 mb-3"
      >
        <div class="absolute inset-0 bg-gradient-to-r from-[#ef4444]/8 to-transparent" />
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-[#ef4444]/60 via-[#ef4444]/25 to-transparent" />
        <div class="absolute -right-12 top-1/2 -translate-y-1/2 w-48 h-48 rounded-full bg-[#ef4444]/8 blur-3xl group-hover:bg-[#ef4444]/12 transition-colors duration-500 pointer-events-none" />
        <div class="relative z-10 w-11 h-11 rounded-xl bg-[#ef4444]/15 border border-[#ef4444]/35 flex items-center justify-center shrink-0">
          <Icon name="youtube" class="w-5 h-5" style="color: #ef4444" />
        </div>
        <div class="relative z-10 flex-1 min-w-0">
          <p class="text-sm font-semibold text-foreground group-hover:text-[#ef4444] transition-colors">YouTube</p>
          <p class="text-xs text-muted mt-0.5">tech, projects and creative process</p>
        </div>
        <Icon name="arrow-up-right" class="relative z-10 w-4 h-4 text-muted/40 group-hover:text-[#ef4444] group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all duration-200 shrink-0" />
      </a>

      <!-- social grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
        {social.map((s) => (
          <a
            href={s.url}
            target={s.url.startsWith('http') ? '_blank' : undefined}
            rel={s.url.startsWith('http') ? 'noopener noreferrer' : undefined}
            class="group relative flex items-center gap-4 p-4 sm:p-5 rounded-2xl border overflow-hidden hover:scale-[1.005] active:scale-[0.999] transition-all duration-200"
            style={`border-color: ${s.color}30`}
          >
            <div
              class="absolute inset-0"
              style={`background: linear-gradient(to right, ${s.color}08, transparent)`}
            />
            <div
              class="absolute inset-x-0 top-0 h-px"
              style={`background: linear-gradient(to right, ${s.color}55, ${s.color}20, transparent)`}
            />
            <div
              class="absolute -right-8 top-1/2 -translate-y-1/2 w-28 h-28 rounded-full blur-2xl pointer-events-none opacity-60 group-hover:opacity-100 transition-opacity duration-500"
              style={`background: ${s.color}10`}
            />
            <div
              class="relative z-10 w-10 h-10 rounded-xl flex items-center justify-center border shrink-0"
              style={`background: ${s.color}15; border-color: ${s.color}35`}
            >
              <Icon name={s.icon} class="w-4.5 h-4.5" style={`color: ${s.color}`} />
            </div>
            <div class="relative z-10 flex-1 min-w-0">
              <p class="text-sm font-semibold text-foreground truncate">{s.label}</p>
              <p class="text-xs text-muted mt-0.5 truncate">{s.desc}</p>
            </div>
            <Icon name="arrow-up-right" class="relative z-10 w-3.5 h-3.5 text-muted/35 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all duration-200 shrink-0" />
          </a>
        ))}
      </div>
    </section>

    <!-- ─── open source ───────────────────────────────────────── -->
    <section class="mb-10 fade-up delay-3">
      <div class="flex items-center gap-3 mb-3">
        <div class="h-px flex-1 bg-gradient-to-r from-transparent to-border" />
        <span class="text-[10px] text-muted uppercase tracking-[0.18em]">open source</span>
        <div class="h-px flex-1 bg-gradient-to-l from-transparent to-border" />
      </div>

      <a
        href="https://github.com/felipecepluki/agree-first"
        target="_blank"
        rel="noopener noreferrer"
        class="group relative flex items-start gap-4 p-5 rounded-2xl border border-border bg-surface/30 hover:bg-surface hover:border-[#22c55e]/40 hover:scale-[1.005] active:scale-[0.999] transition-all duration-200 overflow-hidden"
      >
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[#22c55e]/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity" />
        <div class="w-11 h-11 rounded-xl flex items-center justify-center border border-[#22c55e]/30 bg-[#22c55e]/10 shrink-0">
          <Icon name="shield" class="w-5 h-5" style="color: #22c55e" />
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-sm font-semibold text-foreground group-hover:text-[#22c55e] transition-colors mb-0.5">agree-first</p>
          <p class="text-xs text-muted leading-relaxed">headless React library for consent and terms acceptance flows — scroll enforcement, audit trails and multi-document support</p>
        </div>
        <Icon name="arrow-up-right" class="w-4 h-4 text-muted/40 group-hover:text-[#22c55e] group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all duration-200 shrink-0 self-start mt-0.5" />
      </a>
    </section>

    <!-- ─── pages ─────────────────────────────────────────────── -->
    <section class="fade-up delay-4">
      <div class="flex items-center gap-3 mb-3">
        <div class="h-px flex-1 bg-gradient-to-r from-transparent to-border" />
        <span class="text-[10px] text-muted uppercase tracking-[0.18em]">pages</span>
        <div class="h-px flex-1 bg-gradient-to-l from-transparent to-border" />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
        {pages.map((pg) => (
          <a
            href={pg.href}
            class="group flex items-center gap-3.5 p-4 rounded-2xl border border-border bg-surface/30 hover:bg-surface hover:scale-[1.02] active:scale-[0.98] transition-all duration-200"
          >
            <div
              class="w-10 h-10 rounded-xl flex items-center justify-center border shrink-0"
              style={`background: ${pg.color}15; border-color: ${pg.color}30`}
            >
              <Icon name={pg.icon} class="w-4.5 h-4.5" style={`color: ${pg.color}`} />
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-semibold text-foreground group-hover:text-[#00c8ff] transition-colors">{pg.name}</p>
              <p class="text-xs text-muted mt-0.5">{pg.desc}</p>
            </div>
            <Icon name="arrow-up-right" class="w-3.5 h-3.5 text-muted/40 group-hover:text-[#00c8ff] group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all duration-200 shrink-0" />
          </a>
        ))}
      </div>
    </section>

  </div>
</Layout>
